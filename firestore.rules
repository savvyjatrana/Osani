rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read the product catalog (needed for the storefront).
    // Only signed-in admins (Firebase Auth users you created for admin.html)
    // can create/update/delete products.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: any visitor (including guests) can CREATE an order — this is
    // what lets checkout work without forcing login. Anyone who has the
    // specific Order ID (shown once on the confirmation screen, acting like
    // a confirmation number) can look up THAT single order for tracking.
    // Nobody but a signed-in admin can LIST/QUERY the whole orders
    // collection, or edit/delete an order directly from the client — status
    // updates after creation should only happen via the Cloud Functions,
    // which use the Admin SDK and bypass these rules entirely.
    match /orders/{orderId} {
      allow create: if true;
      allow get: if true;
      allow list: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Printrove token cache — server-side (Cloud Functions) only.
    // No client should ever read or write this directly.
    match /config/printrove {
      allow read, write: if false;
    }
  }
}
